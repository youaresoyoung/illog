{
  "name": "illog",
  "version": "0.1.0",
  "description": "A descktop application for managing and organizing your notes, tasks, and projects in a simple and efficient way.",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:mac": "electron-forge make --arch=universal",
    "publish": "electron-forge publish",
    "prepare": "husky",
    "icons:generate": "npx tsx scripts/generate-icons.ts",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "db:generate": "cd src/main && npx drizzle-kit generate",
    "db:migrate": "npm rebuild better-sqlite3 && cd src/main && npx drizzle-kit migrate && electron-rebuild -f -w better-sqlite3",
    "db:studio": "npm rebuild better-sqlite3 && cd src/main && npx drizzle-kit studio"
  },
  "keywords": [],
  "author": {
    "name": "youaresoyoung",
    "email": "zero.so.jung@gmail.com"
  },
  "license": "ISC",
  "packageManager": "pnpm@10.12.3",
  "devDependencies": {
    "@electron-forge/cli": "^7.8.0",
    "@electron-forge/maker-deb": "^7.8.0",
    "@electron-forge/maker-dmg": "^7.8.0",
    "@electron-forge/maker-squirrel": "^7.8.0",
    "@electron-forge/maker-zip": "^7.8.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.0",
    "@electron-forge/plugin-fuses": "^7.8.0",
    "@electron-forge/plugin-vite": "^7.8.0",
    "@electron-forge/publisher-s3": "^7.8.0",
    "@electron-forge/shared-types": "^7.8.0",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.0.2",
    "@google/genai": "^1.33.0",
    "@illog/analytics": "workspace:*",
    "@illog/themes": "workspace:*",
    "@illog/ui": "workspace:*",
    "@lexical/code": "^0.39.0",
    "@lexical/link": "^0.39.0",
    "@lexical/list": "^0.39.0",
    "@lexical/markdown": "^0.39.0",
    "@lexical/react": "^0.39.0",
    "@lexical/rich-text": "^0.39.0",
    "@sentry/electron": "^7.7.1",
    "@tanstack/react-query": "^5.90.11",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/string-similarity": "^4.0.2",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "electron": "^39.2.7",
    "electron-devtools-installer": "^4.0.0",
    "electron-log": "^5.4.3",
    "electron-window-state": "^5.0.3",
    "lexical": "^0.39.0",
    "natural": "^8.1.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.10.1",
    "sharp": "^0.34.5",
    "string-similarity": "^4.0.4",
    "zustand": "^5.0.9"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2"
  }
}
