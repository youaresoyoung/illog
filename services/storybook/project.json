{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "illog-storybook",
  "projectType": "application",
  "root": "services/storybook",
  "sourceRoot": "services/storybook",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "cwd": "services/storybook", "command": "pnpm build-storybook" },
      "outputs": ["{projectRoot}/storybook-static"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": { "cwd": "services/storybook", "command": "pnpm storybook" }
    }
  }
}
