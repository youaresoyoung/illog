{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "illog-ui",
  "projectType": "library",
  "root": "packages/ui",
  "sourceRoot": "packages/ui/src",
  "implicitDependencies": ["illog-themes"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "cwd": "packages/ui", "command": "pnpm build" },
      "outputs": ["{projectRoot}/dist"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "cwd": "packages/ui", "command": "pnpm exec eslint --cache ." }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "cwd": "packages/ui", "command": "pnpm exec tsc --noEmit" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "cwd": "packages/ui", "command": "pnpm test" }
    },
    "spec-validate": {
      "executor": "nx:run-commands",
      "options": { "cwd": "packages/ui", "command": "pnpm spec:validate" }
    },
    "spec-generate": {
      "executor": "nx:run-commands",
      "options": { "cwd": "packages/ui", "command": "pnpm spec:generate" }
    }
  }
}
